# Application
APP_NAME=B2B Sales Pipeline
APP_VERSION=1.0.0
DEBUG=false

# Security
SECRET_KEY=your-super-secret-key-change-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=43200

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/b2b_sales

# Redis
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Email (SMTP)
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=your-email@yourdomain.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=your-email@yourdomain.com
SMTP_USE_TLS=true

# Zalo OA
ZALO_OA_APP_ID=
ZALO_OA_SECRET_KEY=
ZALO_OA_ACCESS_TOKEN=
ZALO_OA_REFRESH_TOKEN=

# LinkedIn
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:8000/auth/linkedin/callback

# Apollo.io
APOLLO_API_KEY=
APOLLO_BASE_URL=https://api.apollo.io/v1

# AI / LLM
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_TOKENS=2000
OPENAI_TEMPERATURE=0.7

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-haiku-20240307

# Scraping
SCRAPER_DELAY_MIN=2.0
SCRAPER_DELAY_MAX=5.0
SCRAPER_TIMEOUT=30
SCRAPER_MAX_RETRIES=3
PLAYWRIGHT_HEADLESS=true

# Outreach
OUTREACH_DAILY_LIMIT=30
OUTREACH_DELAY_MIN=8.0
OUTREACH_DELAY_MAX=15.0
OUTREACH_FOLLOWUP_DAYS=3
OUTREACH_MAX_FOLLOWUPS=3

# Zalo OA
ZALO_OA_ID=
ZALO_OA_SECRET=

# LinkedIn Automation
LINKEDIN_AUTOMATION_ENABLED=false

# Monitoring
SENTRY_DSN=
LOG_LEVEL=INFO

# File Storage
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760